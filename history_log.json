    # 1. Проверяем существование и считываем весь массив данных целиком
    if not os.path.exists(LOG_FILE_PATH) or os.path.getsize(LOG_FILE_PATH) == 0:
        log_data = []
    else:
        try:
            with open(LOG_FILE_PATH, "r", encoding="utf-8") as f:
                log_data = json.load(f)
        except json.JSONDecodeError:
            logger.error("Ошибка десериализации. Нарушена структура матрицы JSON.")
            return

    # 2. Формируем новый узел строго по структуре оригинальных блоков из Гитхаба
