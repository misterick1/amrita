async function initMonitor() {
    try {
        // Запрос реального файла данных из вашего репозитория docs/data.json
        const response = await fetch('docs/data.json');
        const data = await response.json();

        // Извлекаем первый объект из массива (индекс 0, строки 4-14 на скрине)
        const currentFlow = data[0]; 

        // Вывод Фрактальной мерности Атмы в поле EVO
        document.getElementById('evo-points').innerText = currentFlow.butterfly_node.fractal_dimension;

        // Вывод Ранга Ядра на основе статуса Мира Амриты
        document.getElementById('kernel-rank').innerText = currentFlow.butterfly_node.amrita_world_status;

        // Рендеринг контейнера логов строго по вашей структуре
        const logsContainer = document.getElementById('logs-container');
        logsContainer.innerHTML = "";

        const div = document.createElement('div');
        div.className = 'log-entry';
        div.innerHTML = `
            <div><strong>Поток (Flow):</strong> ${currentFlow.flow}</div>
            <div><strong>Аватар Богини:</strong> ${currentFlow.butterfly_node.goddess_avatar}</div>
            <div><strong>Частота Крыла (Frequency):</strong> <span style="color:#00ffcc;">${currentFlow.butterfly_node.butterfly_wings_frequency}</span></div>
            <div><strong>Манифест Наблюдателя:</strong> ${currentFlow.butterfly_node.manifest}</div>
            <div><strong>Метка времени (Time Stamp):</strong> ${currentFlow.time_stamp_242}</div>
        `;
        logsContainer.appendChild(div);

    } catch (e) {
        document.getElementById('evo-points').innerText = "ОШИБКА JSON";
        document.getElementById('kernel-rank').innerText = "СБОЙ СИНХРОНИЗАЦИИ";
        console.error("Ошибка чтения оригинального data.json: ", e);
    }
}
